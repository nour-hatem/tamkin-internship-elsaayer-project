# Frontend URL.
# For local testing on this machine, keep localhost.
# If another device needs to access the frontend over the LAN,
# replace localhost with this computer's LAN IP.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL.
# For local testing on this machine, keep localhost.
# If the frontend is accessed from another device over the LAN,
# replace localhost with this computer's LAN IP.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001