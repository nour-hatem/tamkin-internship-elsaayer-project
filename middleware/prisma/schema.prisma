datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CustomerProfile {
  id        String   @id @default(uuid())
  plate     String   @unique
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plate])
  @@map("customer_profiles")
}
