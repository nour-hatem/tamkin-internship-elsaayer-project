# NOTE: Environment configuration is unified at the repository root.
# Copy `.env.example` in the project root to `.env`:
#   cp ../.env.example ../.env
# The middleware ConfigModule and Prisma scripts automatically load `../.env`.

PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://toyota_user:toyota_password@localhost:5432/toyota_kiosk?schema=public"
REDIS_URL="redis://localhost:6379"

# Approach switch: voice | qr
ACTIVE_APPROACH=voice

# Adapters
SAP_ADAPTER=prisma
LPR_ADAPTER=stub
GATE_ADAPTER=stub
STT_ADAPTER=stub
TTS_ADAPTER=stub
NLU_ADAPTER=rules
LLM_ADAPTER=stub

# AI / Voice Layer
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE=ar
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
STT_TIMEOUT_MS=5000
TTS_TIMEOUT_MS=5000
LLM_TIMEOUT_MS=1500
