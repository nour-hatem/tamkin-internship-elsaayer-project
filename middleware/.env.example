PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://toyota_user:toyota_password@localhost:5433/toyota_kiosk?schema=public"
REDIS_URL="redis://localhost:6379"

# Public frontend URL used in QR check-in links.
# For local testing on this machine, keep localhost.
# If another device needs to scan the QR code,
# replace localhost with this computer's LAN IP.
APP_URL=http://localhost:3000

# Approach switch: voice | qr
# ACTIVE_APPROACH=qr

# Adapters
SAP_ADAPTER=prisma
LPR_ADAPTER=stub
GATE_ADAPTER=stub
STT_ADAPTER=stub
TTS_ADAPTER=stub
NLU_ADAPTER=stub
LLM_ADAPTER=stub