{
  "name": "toyota-kiosk-queue-system",
  "version": "1.0.0",
  "private": true,
  "description": "Internal MVP for Toyota Kiosk / Queue System (Ports & Adapters, Voice + QR convergence)",
  "workspaces": [
    "middleware",
    "web"
  ],
  "scripts": {
    "dev": "npm run start:dev --workspace=middleware & npm run dev --workspace=web",
    "dev:middleware": "npm run start:dev --workspace=middleware",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=middleware && npm run build --workspace=web",
    "start": "npm run start --workspace=middleware",
    "test": "npm run test --workspace=middleware",
    "typecheck": "npm run typecheck --workspace=middleware && npm run typecheck --workspace=web",
    "prisma:generate": "prisma generate --schema=middleware/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=middleware/prisma/schema.prisma",
    "prisma:seed": "ts-node -r dotenv/config middleware/prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=middleware/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.3.3"
  }
}
