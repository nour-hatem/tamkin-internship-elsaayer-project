# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000

# Database & Cache
DATABASE_URL=postgresql://toyota_user:toyota_password@localhost:5432/toyota_kiosk?schema=public
REDIS_URL=redis://localhost:6379

# Active Entry Channel (voice | qr)
ACTIVE_APPROACH=voice

# Adapter Selection (hexagonal ports & adapters)
# SAP: prisma | stub
SAP_ADAPTER=prisma
# LPR: stub | camera
LPR_ADAPTER=stub
# Gate: stub | relay
GATE_ADAPTER=stub
# STT: stub | whisper | vosk
STT_ADAPTER=stub
# TTS: stub | piper | elevenlabs
TTS_ADAPTER=stub
# NLU: stub | rasa | regex
NLU_ADAPTER=stub
# LLM: stub | ollama | openai
LLM_ADAPTER=stub

# Frontend URLs
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
