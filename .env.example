# ==============================================================================
# Toyota Kiosk & Queue System — Unified Monorepo Environment Configuration
# Copy this file to `.env` at the repository root:
#   cp .env.example .env
# ==============================================================================

# Application & Ports
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000

# Database & Cache (Used by Prisma & Middleware)
DATABASE_URL="postgresql://toyota_user:toyota_password@localhost:5432/toyota_kiosk?schema=public"
REDIS_URL="redis://localhost:6379"

# Frontend Next.js Public URLs
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Active Entry Channel (voice | qr)
ACTIVE_APPROACH=voice

# Adapter Selection (hexagonal ports & adapters)
SAP_ADAPTER=prisma
LPR_ADAPTER=stub
GATE_ADAPTER=stub
STT_ADAPTER=stub
TTS_ADAPTER=stub
NLU_ADAPTER=rules
LLM_ADAPTER=stub

# AI / Voice Layer Configuration
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE=ar

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

STT_TIMEOUT_MS=5000
TTS_TIMEOUT_MS=5000
LLM_TIMEOUT_MS=1500
